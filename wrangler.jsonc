{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "neural-nautic",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Selbstreferenz, Name muss dem Worker-Namen entsprechen
      "binding": "WORKER_SELF_REFERENCE",
      "service": "neural-nautic"
    }
  ],
  "images": {
    // next/image-Optimierung ueber Cloudflare Images (Free: 5.000 Transformationen/Monat)
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
