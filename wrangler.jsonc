{
  // Cloudflare Workers mit Static Assets plus kleinem Worker fuer /api/* und die Header (src/worker/).
  // Gleicher Weg wie nn-ki-agententeam und Karlson. Nicht Vercel: Hobby-Plan erlaubt keine
  // gewerbliche Nutzung und hat keine AVV.
  // Workers Builds: Build-Befehl `npm run build`, Deploy `npx wrangler deploy`. Push = Deploy.
  // Geheimnisse (nicht hier, sondern per `npx wrangler secret put`): RESEND_API_KEY, MISTRAL_API_KEY.
  // Ohne sie antworten Kontakt und Chat ehrlich mit 503; Downloads ohne Kontaktdaten gehen trotzdem.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neural-nautic",   // Live-Worker mit neuralnautic.de, www und den Schluesseln; im Repo funnel-neuralnautic steht hier "funnel-neuralnautic" (Vorschau). Einzige Abweichung, beim Mergen behalten.
  "main": "src/worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Adressen ohne Schraegstrich wie auf neuralnautic.de: /leistungen liefert leistungen/index.html,
    // /leistungen/ leitet auf /leistungen um. Passt zu den Canonicals.
    "html_handling": "drop-trailing-slash",
    // Jede Anfrage zuerst durch den Worker: Header und noindex je Adresse an einer Stelle (index.js)
    "run_worker_first": true
  },
  // Downloads werden in den Worker eingebettet, nicht aus public/ ausgeliefert (A8)
  "rules": [
    { "type": "Data", "globs": ["**/*.pdf"] },
    { "type": "Text", "globs": ["**/*.svg"] }
  ],
  // Workers Logs: in der Datenschutzerklaerung (Abschnitt 4) genannt, Loeschung nach hoechstens 7 Tagen
  "observability": {
    "enabled": true
  },
  // Vorschau unter funnel-neuralnautic.<konto>.workers.dev (noindex per Worker), keine Vorschau-URLs je Branch
  "workers_dev": true,
  "preview_urls": false
}
